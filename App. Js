
import React, { useState } from 'react';
import { View, Text, TouchableOpacity, StyleSheet, Alert } from 'react-native';
import { createClient } from '@supabase/supabase-js';
const supabase = createClient('YOUR_SUPABASE_URL','YOUR_SUPABASE_KEY');
export default function App(){
const [balance,setBalance]=useState(0);
const handleWin=async(amount)=>{
const yourCut=amount*0.6;const playerCut=amount*0.4;
await supabase.from('transactions').insert([{amount:yourCut,type:'platform_fee',player:'platform'},{amount:playerCut,type:'player_win',player:'current_user'}]);
Alert.alert("WIN!",`You won ${amount} sats! You: ${playerCut} (40%) Platform: ${yourCut} (60%) Speed instant payout`);
setBalance(b=>b+playerCut);
};
return(
<View style={styles.container}>
<Text style={styles.title}>SWARMSATS ⚡</Text>
<Text style={styles.balance}>Balance: {balance} sats</Text>
<TouchableOpacity style={styles.winButton} onPress={()=>handleWin(1000)}>
<Text style={styles.buttonText}>WIN 1000 SATS</Text>
</TouchableOpacity>
<Text style={styles.split}>60% You / 40% Player - Speed ⚡</Text>
</View>
);
}
const styles=StyleSheet.create({container:{flex:1,backgroundColor:'#000',alignItems:'center',justifyContent:'center',padding:20},title:{fontSize:40,fontWeight:'bold',color:'#FFD700',marginBottom:20},balance:{fontSize:24,color:'#fff',marginBottom:40},winButton:{backgroundColor:'#FFD700',padding:20,borderRadius:15,width:'100%',alignItems:'center'},buttonText:{fontSize:18,fontWeight:'bold',color:'#000'},split:{marginTop:20,color:'#aaa'}});
